# AI Service Configuration
# Choose your AI provider: 'openai' (default), 'claude', or 'hybrid'
VITE_AI_PROVIDER=openai

# OpenAI API Key (for GPT-4)
# Get it from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Anthropic Claude API Key (optional fallback)
# Get it from: https://console.anthropic.com/
VITE_CLAUDE_API_KEY=

# OpenAI is disabled by default to avoid paid requests.
OPENAI_ENABLED=false

# Supabase Configuration (optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to 'true' to enable local (in-browser) visual generation using ReuNexus procedural engine
# Useful for generating SVG images without calling external APIs
VITE_LOCAL_VISUAL=false

# Use the Ollama installation on this computer for chat without API costs.
VITE_LOCAL_AI=false
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3
# Set true to fail instead of using the hosted route when Ollama is offline.
VITE_LOCAL_AI_ONLY=false
# Cache up to 100 successful text answers in this browser before making another AI request.
VITE_FREE_MESH=true

# Free local chat through Ollama. A hosted Supabase function cannot reach localhost.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b